{
  "name": "pi-artifact-manager",
  "version": "0.1.0",
  "description": "Pi coding-agent extension for managing session artifacts - collect, organize, and reference generated files and outputs across sessions.",
  "author": "",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PLACEHOLDER/pi-artifact-manager.git"
  },
  "homepage": "https://github.com/PLACEHOLDER/pi-artifact-manager#readme",
  "bugs": {
    "url": "https://github.com/PLACEHOLDER/pi-artifact-manager/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "artifact",
    "artifact-management",
    "session",
    "llm",
    "ai"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "index.ts",
    "src/ios/**/*.ts",
    "src/**/*.ts",
    "src/db/schema.sql",
    "README.md"
  ],
  "scripts": {
    "postinstall": "node scripts/dedupe-pi.mjs",
    "test": "bun test tests/unit/ tests/e2e/ tests/l2/ tests/benchmark/",
    "test:unit": "bun test tests/unit/",
    "test:e2e": "bun test tests/e2e/",
    "test:l2": "bun test tests/l2/",
    "test:l3": "bun test tests/l3/",
    "test:bench": "bun test tests/benchmark/",
    "typecheck": "tsc --noEmit"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "exports": {
    ".": "./index.ts",
    "./ios": "./src/ios/index.ts"
  },
  "dependencies": {
    "typebox": "1.3.7"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true }
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-agent-core": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "typebox": "1.3.7",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
